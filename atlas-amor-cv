  <style>
        body { font-family: 'DM Sans', sans-serif; }
        h1, h2, h3 { font-family: 'Fraunces', serif; }
        
        @keyframes float-haunted {
            0%, 100% { transform: translateY(0px); opacity: 0.7; }
            50% { transform: translateY(-20px); opacity: 0.9; }
        }
        
        @keyframes glitch-title {
            0%, 100% { text-shadow: none; }
            20% { text-shadow: -2px 0 #7c3aed, 2px 0 #06b6d4; transform: translateX(-1px); }
            40% { text-shadow: 2px 0 #f472b6, -2px 0 #facc15; transform: translateX(1px); }
            60% { text-shadow: -2px 0 #06b6d4, 2px 0 #7c3aed; transform: translateX(-1px); }
            80% { text-shadow: 2px 0 #facc15, -2px 0 #f472b6; transform: translateX(1px); }
        }
        
        @keyframes breathe-shadow {
            0%, 100% { filter: drop-shadow(0 0 8px rgba(124, 58, 237, 0.4)); }
            50% { filter: drop-shadow(0 0 20px rgba(6, 182, 212, 0.6)); }
        }
        
        .planet {
            position: absolute;
            border-radius: 50%;
            animation: float-haunted 6s ease-in-out infinite;
        }
        
        .planet:nth-child(1) { animation-delay: 0s; }
        .planet:nth-child(2) { animation-delay: 1s; }
        .planet:nth-child(3) { animation-delay: 2s; }
        
        .triangle {
            width: 0; height: 0;
            border-left: 60px solid transparent;
            border-right: 60px solid transparent;
            border-bottom: 100px solid;
            animation: float-haunted 7s ease-in-out infinite reverse;
        }
        
        h1 {
            animation: glitch-title 8s ease-in-out infinite;
        }
        
        .cosmic-orb {
            animation: breathe-shadow 4s ease-in-out infinite;
        }
    </style>
